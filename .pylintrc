[MAIN]
persistent=no

[MESSAGES CONTROL]
disable=cyclic-import,
        duplicate-code,
        fixme,
        too-few-public-methods,
        too-many-instance-attributes

[REPORTS]
output-format=colorized
reports=no

[FORMAT]
max-line-length=120

[DESIGN]
max-args=8
max-positional-arguments=5
max-locals=20
max-returns=10
max-branches=12

[SIMILARITIES]
ignore-imports=yes
